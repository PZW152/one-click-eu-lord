# PowerShell scripts are CRLF on Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Rust, manifests, docs and data are UTF-8/LF.
*.rs text eol=lf
*.toml text eol=lf
*.manifest text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf

# Never touch these.
*.png binary
*.ico binary
*.exe binary

